# GeovaX / SAMANVAY — real government connector configuration template.
#
# Copy this file to `.env` and fill in genuine, legitimately-issued credentials. Every
# variable below gates a real, production-ready connector (backend/samanvay/analytics/
# litigation.py, backend/samanvay/ingest/{naksha,soi_cors,tn_revenue}.py) that is fully wired
# into the pipeline/API/UI already — setting these is the ONLY step left to make each one
# genuinely live.
#
# NEVER commit a real `.env` file. NEVER hardcode a credential in source. NEVER share a
# filled-in copy of this file. If a value below isn't yours to hold (e.g. a departmental
# NAPIX key issued to a different organisation), leave it unset — the connector will
# honestly report "credential_required" rather than silently failing or fabricating data.

# --- Core platform -----------------------------------------------------------------------
# Random 32+ byte secret for signing session JWTs. Required in any shared/production
# deployment (a per-process ephemeral secret is generated automatically for local dev, with
# a loud warning, but tokens won't survive a restart).
SAMANVAY_JWT_SECRET=

# --- 1. e-Courts / NJDG (via NAPIX, NDSAP Open API) ---------------------------------------
# Issued to a registered Central/State Government department at https://napix.gov.in.
# See backend/samanvay/analytics/litigation.py's module docstring for the real mechanism
# this was verified against (services.ecourts.gov.in requires CAPTCHA for every public
# query — confirmed directly; NAPIX is the only legitimate programmatic path).
NJDG_API_BASE_URL=
NJDG_DEPT_ID=
NJDG_ACCESS_KEY=
# Optional: where the last-successful-sync cache is written (defaults to out/ecourts_cache.json)
NJDG_SYNC_CACHE_PATH=

# --- 2. Tamil Nadu Registration Dept. — Encumbrance Certificate (STAR 2.0) ----------------
# No NDSAP/NAPIX-equivalent open-data path exists for this service (verified: per-citizen
# self-service EC lookup only). Set this only if/when tnreginet.gov.in publishes one.
REGISTRATION_API_URL=

# --- 3. Tamil Nadu Revenue Records — Patta/Chitta/FMB/A-Register (TamilNilam) -------------
# tamilnilam.tn.gov.in is OTP+CAPTCHA-gated per citizen query (verified directly this
# session; its real backend base is https://tamilnilam.tn.gov.in/egovService/). Either
# supply a full login, or — the only legitimate automation path for an OTP-gated portal — a
# session cookie from a session a human already verified via real OTP in a real browser.
TN_REVENUE_USERNAME=
TN_REVENUE_PASSWORD=
TN_REVENUE_SESSION_COOKIE=
# Only set if you have inspected your own authenticated session's network tab and found the
# real lookup path — see backend/samanvay/ingest/tn_revenue.py's module docstring.
TN_REVENUE_LOOKUP_PATH=

# --- 4. NAKSHA (DoLR national cadastral mapping platform) ---------------------------------
# A real State Programme Management Unit (SPMU) credential for DoLR's ArcGIS Enterprise
# backend at nakshagis.dolr.gov.in — verified live this session (real token-based security,
# real Tamil Nadu FeatureServer at Naksha_tn_33_44 covering Chennai). See
# backend/samanvay/ingest/naksha.py's module docstring for the exact endpoints confirmed.
NAKSHA_USERNAME=
NAKSHA_PASSWORD=
# Esri tokens are scoped to a referer URL; only change this if your SPMU credential requires
# a specific registered referer.
NAKSHA_REFERER=

# --- 5. Survey of India CORS Network Portal — RINEX / Virtual RINEX -----------------------
# A real, approved CORS Portal subscription (free for government/academic users after
# registration + manual SoI approval; paid for private/PSU users — see
# backend/samanvay/ingest/soi_cors.py's module docstring for the real registration/
# subscription-tier workflow this was verified against).
SOI_CORS_USERNAME=
SOI_CORS_PASSWORD=
# Only set these if you have inspected your own authenticated session and found the real
# backend paths — the defaults are honestly documented as unconfirmed guesses.
SOI_CORS_LOGIN_PATH=
SOI_CORS_RDS_PATH=

# --- Optional infrastructure ---------------------------------------------------------------
DATABASE_URL=
REDIS_URL=
GEOVAX_OUT=out/chennai_metro
